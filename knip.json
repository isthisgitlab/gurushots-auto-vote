{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/js/index.ts",
        "src/js/preload.ts",
        "src/js/bridge/capacitor.ts",
        "src/js/headless/index.ts",
        "src/js/react/pages/Login.jsx",
        "src/js/react/pages/App.jsx",
        "src/js/react/pages/Logs.jsx",
        "src/js/react/pages/Capacitor.jsx",
        "scripts/*.js"
    ],
    "project": ["src/**/*.{js,jsx,ts,tsx,css}", "scripts/**/*.{js,ts}", "tests/**/*.{js,jsx,ts,tsx}"],
    "paths": {
        "@/*": ["src/js/react/*"]
    },
    "ignoreDependencies": ["postject"],
    "ignoreBinaries": ["osascript", "notify-send"],
    "rules": {
        "exports": "off",
        "nsExports": "off"
    }
}
