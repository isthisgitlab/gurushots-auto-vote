{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/js/preload.js",
        "src/js/bridge/capacitor.js",
        "src/js/headless/index.js",
        "src/js/react/pages/Login.jsx",
        "src/js/react/pages/App.jsx",
        "src/js/react/pages/Logs.jsx",
        "src/js/react/pages/Capacitor.jsx",
        "scripts/*.js"
    ],
    "project": ["src/**/*.{js,jsx}", "scripts/**/*.js", "tests/**/*.{js,jsx}"],
    "paths": {
        "@/*": ["src/js/react/*"]
    },
    "ignoreDependencies": ["react", "react-dom", "postject", "@ttsc/lint", "@ttsc/graph"],
    "rules": {
        "exports": "off",
        "nsExports": "off"
    }
}
