{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/js/index.ts",
        "src/js/preload.ts",
        "src/js/bridge/capacitor.ts",
        "src/js/headless/index.ts",
        "src/js/react/pages/Login.tsx",
        "src/js/react/pages/App.tsx",
        "src/js/react/pages/Logs.tsx",
        "src/js/react/pages/Capacitor.tsx",
        "scripts/*.ts",
        "scripts/afterPack.mts",
        "src/js/types/globals.ts",
        "tests/jest-matchers.ts"
    ],
    "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.{ts,mts}", "tests/**/*.{ts,tsx,cts}"],
    "paths": {
        "@/*": ["src/js/react/*"]
    },
    "ignoreDependencies": ["postject"],
    "ignoreBinaries": ["osascript", "notify-send", "pgrep"],
    "rules": {
        "exports": "off",
        "nsExports": "off"
    }
}
