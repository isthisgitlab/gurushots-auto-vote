{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/ts/shells/electron/index.ts",
        "src/ts/shells/electron/preload.ts",
        "src/ts/shells/capacitor/bridge/capacitor.ts",
        "src/ts/shells/headless/index.ts",
        "src/ts/react/pages/Login.tsx",
        "src/ts/react/pages/App.tsx",
        "src/ts/react/pages/Logs.tsx",
        "src/ts/shells/capacitor/page.tsx",
        "src/ts/shells/web/page.tsx",
        "scripts/*.ts",
        "scripts/afterPack.mts",
        "src/ts/core/types/globals.ts",
        "tests/jest-matchers.ts"
    ],
    "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.{ts,mts}", "tests/**/*.{ts,tsx,cts}"],
    "paths": {
        "@/*": ["src/ts/react/*"]
    },
    "ignoreDependencies": ["postject"],
    "ignoreBinaries": ["notify-send", "pgrep"],
    "rules": {
        "exports": "off",
        "nsExports": "off"
    }
}
