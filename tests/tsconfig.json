{
    // The tests' own program: the app's strict settings plus Jest's globals,
    // kept out of the src/ts program so app code cannot reach for them.
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "types": ["node", "jest"]
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.cts",
        "../src/ts/**/*.ts",
        "../src/ts/**/*.tsx",
        "../scripts/**/*.ts",
        "../scripts/**/*.mts"
    ]
}
