{
    "name": "gurushots-auto-vote",
    "version": "1.12.2",
    "description": "GuruShots Auto Vote - An Electron application for automated voting on GuruShots challenges with unified GUI and CLI interfaces (supports both real and mock modes)",
    "main": "out/main/index.js",
    "scripts": {
        "build": "cross-env NODE_ENV=production electron-builder",
        "build:all": "pnpm run build:prep && cross-env NODE_ENV=production electron-builder -mwl",
        "build:cli:all": "node --import tsx scripts/build-cli.ts",
        "build:cli:linux": "node --import tsx scripts/build-cli.ts gurucli-linux",
        "build:cli:linux-arm": "node --import tsx scripts/build-cli.ts gurucli-linux-arm",
        "build:cli:mac": "node --import tsx scripts/build-cli.ts gurucli-mac",
        "build:cli:all:lite": "node --import tsx scripts/build-cli.ts --lite",
        "build:cli:linux:lite": "node --import tsx scripts/build-cli.ts gurucli-linux --lite",
        "build:cli:linux-arm:lite": "node --import tsx scripts/build-cli.ts gurucli-linux-arm --lite",
        "build:cli:mac:lite": "node --import tsx scripts/build-cli.ts gurucli-mac --lite",
        "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/styles.css --minify",
        "build:lexicon": "node --import tsx scripts/build-lexicon.ts",
        "build:main": "node --import tsx scripts/build-main.ts",
        "fetch:embeddings": "node --import tsx scripts/fetch-embeddings.ts",
        "verify:lexicon": "node --import tsx scripts/validate-lexicon.ts",
        "web": "pnpm run build:css && pnpm run build:react && node --import tsx scripts/web-server.ts",
        "build:react": "node --import tsx scripts/build-react.ts",
        "build:prep": "pnpm run build:css && pnpm run build:lexicon && pnpm run build:react && pnpm run build:main",
        "build:prep:lite": "pnpm run build:css && pnpm run build:lexicon && node --import tsx scripts/build-react.ts --lite && pnpm run build:main",
        "build:site": "pnpm run build:site:html && pnpm run build:site:css",
        "build:site:html": "node --import tsx scripts/build-site.ts",
        "build:site:css": "tailwindcss -i ./scripts/site/site.css -o ./dist-site/styles.css --minify",
        "build:android": "cross-env NODE_ENV=production pnpm run build:prep && pnpm exec cap sync android && cd android && ./gradlew assembleRelease",
        "build:android:lite": "cross-env NODE_ENV=production pnpm run build:prep:lite && pnpm exec cap sync android && cd android && ./gradlew assembleRelease",
        "android:open": "pnpm exec cap open android",
        "build:linux": "pnpm run build:prep && cross-env NODE_ENV=production electron-builder --linux",
        "build:linux-arm": "pnpm run build:prep && cross-env NODE_ENV=production electron-builder --linux --arm64",
        "build:mac": "pnpm run build:prep && cross-env NODE_ENV=production electron-builder --mac",
        "build:win": "pnpm run build:prep && cross-env NODE_ENV=production electron-builder --win",
        "build:linux:lite": "pnpm run build:prep:lite && cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --linux",
        "build:linux-arm:lite": "pnpm run build:prep:lite && cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --linux --arm64",
        "build:mac:lite": "pnpm run build:prep:lite && cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --mac",
        "build:win:lite": "pnpm run build:prep:lite && cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --win",
        "bump": "pnpm dlx npm-check-updates -u && pnpm install",
        "cleanup:logs": "node --import tsx scripts/cleanup-logs.ts",
        "cli:bankroll": "node --import tsx src/ts/cli/cli.ts bankroll",
        "cli:discover": "node --import tsx src/ts/cli/cli.ts discover",
        "cli:help": "node --import tsx src/ts/cli/cli.ts help",
        "cli:login": "node --import tsx src/ts/cli/cli.ts login",
        "cli:reset-windows": "node --import tsx src/ts/cli/cli.ts reset-windows",
        "cli:start": "node --import tsx src/ts/cli/cli.ts start",
        "cli:status": "node --import tsx src/ts/cli/cli.ts status",
        "cli:vote": "node --import tsx src/ts/cli/cli.ts vote",
        "dev": "pnpm run build:main && concurrently --kill-others-on-fail \"pnpm run watch:css\" \"pnpm run watch:react\" \"pnpm run watch:main\" \"electronmon .\"",
        "dev:no-watch": "concurrently --kill-others \"pnpm run watch:css\" \"pnpm run start\"",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gui:refresh": "echo 'If the GUI is running, refresh it manually (Cmd+R / Ctrl+R) to apply CLI settings changes.'",
        "knip": "knip",
        "lint": "oxlint src scripts tests",
        "lint:fix": "oxlint --fix src scripts tests",
        "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('This repository requires pnpm (see packageManager in package.json); npm and yarn are not supported.');process.exit(1)}if(Number(process.versions.node.split('.')[0])<26){console.error('This repository requires Node.js 26 or newer.');process.exit(1)}\"",
        "prebuild": "pnpm run build:prep",
        "prepare": "cross-env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 lefthook install",
        "settings:get": "node --import tsx scripts/settings-cli.ts get",
        "settings:global-defaults": "node --import tsx scripts/settings-cli.ts global-defaults",
        "settings:help": "node --import tsx scripts/settings-cli.ts help",
        "settings:reset": "node --import tsx scripts/settings-cli.ts reset",
        "settings:reset-all": "node --import tsx scripts/settings-cli.ts reset-all",
        "settings:reset-global": "node --import tsx scripts/settings-cli.ts reset-global",
        "settings:schema": "node --import tsx scripts/settings-cli.ts schema",
        "settings:set": "node --import tsx scripts/settings-cli.ts set",
        "settings:set-global": "node --import tsx scripts/settings-cli.ts set-global",
        "size": "cross-env NODE_ENV=production pnpm run build:react && node --import tsx scripts/check-size-delta.ts",
        "size:update": "cross-env NODE_ENV=production pnpm run build:react && node --import tsx scripts/check-size-delta.ts --update",
        "size:cli": "node --import tsx scripts/check-cli-size.ts",
        "start": "pnpm run build:main && electron .",
        "tag": "git tag v$(node -p \"require('./package.json').version\")",
        "tag:push": "pnpm run tag && git push origin v$(node -p \"require('./package.json').version\")",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:watch": "jest --watch",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
        "update:readme": "node --import tsx scripts/readme-version.ts",
        "verify:readme": "node --import tsx scripts/readme-version.ts --check",
        "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/styles.css --watch",
        "watch:main": "node --import tsx scripts/build-main.ts --watch",
        "watch:react": "node --import tsx scripts/build-react.ts --watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/isthisgitlab/gurushots-auto-vote.git"
    },
    "keywords": [],
    "author": {
        "name": "isthisgitlab",
        "email": "isthisgitlab@isthisgitlab.com"
    },
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/isthisgitlab/gurushots-auto-vote/issues"
    },
    "homepage": "https://github.com/isthisgitlab/gurushots-auto-vote#readme",
    "engines": {
        "node": ">=26.0.0"
    },
    "packageManager": "pnpm@12.9.1",
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@capacitor/preferences": "^8.0.1",
        "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
        "@huggingface/transformers": "^4.3.0",
        "@preact/signals": "^2.11.3",
        "axios": "^1.20.0",
        "electron-updater": "^6.8.9",
        "preact": "^11.0.0",
        "tar": "^7.5.22",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.2",
        "@electron/fuses": "^2.1.3",
        "@happy-dom/jest-environment": "^20.14.5",
        "@jest/globals": "^30.5.2",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/preact": "^3.2.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.4",
        "@types/yauzl": "^3.4.0",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "daisyui": "^5.7.47",
        "electron": "^44.5.1",
        "electron-builder": "^26.17.0",
        "electronmon": "^2.0.4",
        "esbuild": "^0.28.2",
        "jest": "^30.5.2",
        "jest-environment-node": "^30.5.2",
        "knip": "^6.39.0",
        "lefthook": "^2.1.16",
        "marked": "^18.0.14",
        "marked-gfm-heading-id": "^4.1.4",
        "onnxruntime-web": "1.31.0-dev.20260918-bc8e7ed75",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "postject": "1.0.0-alpha.6",
        "prettier": "4.0.0-alpha.13",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "yauzl": "^3.4.0"
    },
    "electronmon": {
        "patterns": [
            "!dist/**",
            "!build/**",
            "!coverage/**",
            "!.cache/**",
            "!tests/**",
            "!docs/**",
            "!android/**",
            "!logs/**",
            "!scripts/**",
            "!**/*.test.ts",
            "!**/*.test.tsx"
        ]
    },
    "build": {
        "appId": "com.gurushots.autovote",
        "productName": "GuruShotsAutoVote",
        "afterPack": "scripts/afterPack.mts",
        "compression": "maximum",
        "removePackageScripts": true,
        "removePackageKeywords": true,
        "files": [
            "dist/**/*",
            "out/main/**/*",
            "src/html/**/*",
            "src/assets/**/*",
            "package.json",
            "!dist/vision-model${/*}",
            "!dist/ort-wasm-simd-threaded.*",
            "!**/node_modules/onnxruntime-web${/*}"
        ],
        "extraResources": [
            {
                "from": ".cache/vision-model",
                "to": "vision-model"
            }
        ],
        "asarUnpack": [
            "**/onnxruntime-node/bin/**/*",
            "**/@img/**/*"
        ],
        "directories": {
            "output": "build"
        },
        "mac": {
            "category": "public.app-category.utilities",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                },
                {
                    "target": "dir",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "icon": "src/assets/logo.png",
            "gatekeeperAssess": false,
            "hardenedRuntime": false,
            "artifactName": "GuruShotsAutoVote-v${version}-${arch}.${ext}"
        },
        "win": {
            "compression": "normal",
            "target": "portable",
            "icon": "src/assets/logo.png",
            "artifactName": "GuruShotsAutoVote-v${version}-${arch}.exe"
        },
        "linux": {
            "target": "AppImage",
            "category": "Utility",
            "icon": "src/assets/logo.png",
            "maintainer": "isthisgitlab@isthisgitlab.com",
            "artifactName": "GuruShotsAutoVote-v${version}-${arch}.AppImage"
        },
        "publish": {
            "provider": "github",
            "releaseType": "release"
        }
    },
    "jest": {
        "projects": [
            {
                "displayName": "node",
                "testEnvironment": "node",
                "roots": [
                    "<rootDir>/tests",
                    "<rootDir>/src/ts"
                ],
                "setupFilesAfterEnv": [
                    "<rootDir>/tests/setup.ts"
                ],
                "testMatch": [
                    "**/__tests__/**/*.ts",
                    "**/?(*.)+(spec|test).ts"
                ],
                "transform": {
                    "\\.[mc]?ts$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript"
                                }
                            }
                        }
                    ],
                    "\\.tsx$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript",
                                    "tsx": true
                                },
                                "transform": {
                                    "react": {
                                        "runtime": "automatic",
                                        "importSource": "preact"
                                    }
                                }
                            }
                        }
                    ]
                },
                "moduleNameMapper": {
                    "^@/(.*)$": "<rootDir>/src/ts/react/$1",
                    "^react$": "preact/compat",
                    "^react-dom$": "preact/compat",
                    "^react-dom/client$": "preact/compat/client",
                    "^react/jsx-runtime$": "preact/jsx-runtime",
                    "^react/jsx-dev-runtime$": "preact/jsx-dev-runtime"
                },
                "testPathIgnorePatterns": [
                    "<rootDir>/tests/react/"
                ]
            },
            {
                "displayName": "happy-dom",
                "testEnvironment": "@happy-dom/jest-environment",
                "transformIgnorePatterns": [
                    "/node_modules/(?!.*preact/.*\\.mjs$)"
                ],
                "testEnvironmentOptions": {
                    "customExportConditions": [
                        "node"
                    ]
                },
                "roots": [
                    "<rootDir>/tests/react",
                    "<rootDir>/src/ts"
                ],
                "setupFilesAfterEnv": [
                    "<rootDir>/tests/setup.ts",
                    "<rootDir>/tests/react/helpers/setup.ts"
                ],
                "testMatch": [
                    "**/?(*.)+(spec|test).ts",
                    "**/?(*.)+(spec|test).tsx"
                ],
                "transform": {
                    "\\.mjs$": [
                        "@swc/jest",
                        {
                            "module": {
                                "type": "commonjs"
                            }
                        }
                    ],
                    "\\.[mc]?ts$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript"
                                }
                            }
                        }
                    ],
                    "\\.tsx$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript",
                                    "tsx": true
                                },
                                "transform": {
                                    "react": {
                                        "runtime": "automatic",
                                        "importSource": "preact"
                                    }
                                }
                            }
                        }
                    ]
                },
                "moduleNameMapper": {
                    "^@/(.*)$": "<rootDir>/src/ts/react/$1",
                    "^react$": "preact/compat",
                    "^react-dom$": "preact/compat",
                    "^react-dom/client$": "preact/compat/client",
                    "^react/jsx-runtime$": "preact/jsx-runtime",
                    "^react/jsx-dev-runtime$": "preact/jsx-dev-runtime"
                }
            }
        ],
        "collectCoverage": false,
        "collectCoverageFrom": [
            "src/ts/**/*.{ts,tsx}",
            "scripts/**/*.{ts,mts}"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 100,
                "functions": 100,
                "lines": 100,
                "statements": 100
            }
        }
    }
}
