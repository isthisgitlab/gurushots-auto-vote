{
    "name": "gurushots-auto-vote",
    "version": "1.15.7",
    "description": "GuruShots Auto Vote - An Electron application for automated voting on GuruShots challenges with unified GUI and CLI interfaces (supports both real and mock modes)",
    "main": "out/main/index.js",
    "scripts": {
        "build": "pnpm run turbo run package:electron",
        "build:cli:all": "pnpm run turbo run package:cli-all",
        "build:cli:linux": "pnpm run turbo run package:cli-linux",
        "build:cli:linux-arm": "pnpm run turbo run package:cli-linux-arm",
        "build:cli:mac": "pnpm run turbo run package:cli-mac",
        "build:cli:all:lite": "pnpm run turbo run package:cli-all-lite",
        "build:cli:linux:lite": "pnpm run turbo run package:cli-linux-lite",
        "build:cli:linux-arm:lite": "pnpm run turbo run package:cli-linux-arm-lite",
        "build:cli:mac:lite": "pnpm run turbo run package:cli-mac-lite",
        "bundle:css": "tailwindcss -i ./src/styles/styles.css -o ./out/renderer/styles.css --minify",
        "build:css": "pnpm run turbo run bundle:css",
        "build:lexicon": "node --import tsx scripts/build-lexicon.ts",
        "build:main": "node --import tsx scripts/build-main.ts",
        "build:notices": "node --import tsx scripts/build-notices.ts",
        "fetch:embeddings": "node --import tsx scripts/fetch-embeddings.ts",
        "verify:lexicon": "pnpm run turbo run validate:lexicon",
        "verify:lexicon-generated": "node --import tsx scripts/build-lexicon.ts && git diff --exit-code src/assets/semantic-vectors.json",
        "verify:notices-generated": "node --import tsx scripts/build-notices.ts && git diff --exit-code src/assets/THIRD_PARTY_NOTICES.txt",
        "web": "pnpm run turbo run serve:web --",
        "bundle:renderer-full": "cross-env NODE_ENV=production node --import tsx scripts/build-react.ts --bundles",
        "bundle:renderer-lite": "cross-env NODE_ENV=production node --import tsx scripts/build-react.ts --lite --bundles",
        "assemble:renderer-full": "node --import tsx scripts/build-react.ts --assemble=production",
        "assemble:renderer-lite": "node --import tsx scripts/build-react.ts --lite --assemble=production",
        "assemble:compat-full": "node --import tsx scripts/build-react.ts --assemble",
        "assemble:compat-lite": "node --import tsx scripts/build-react.ts --lite --assemble",
        "build:react": "pnpm run turbo run prepare:compat-full",
        "build:video-decoder": "node --import tsx scripts/build-video-decoder.ts",
        "prepare:video-decoder": "node --import tsx scripts/build-video-decoder.ts --prepare",
        "build:stage-video-decoder": "node --import tsx scripts/build-video-decoder.ts --stage",
        "stage:video-decoder": "node --import tsx scripts/build-video-decoder.ts --stage",
        "stage:video-decoder-linux": "node --import tsx scripts/build-video-decoder.ts --stage=linux-x64",
        "stage:video-decoder-linux-arm": "node --import tsx scripts/build-video-decoder.ts --stage=linux-arm64",
        "stage:video-decoder-mac": "node --import tsx scripts/build-video-decoder.ts --stage=darwin-arm64",
        "stage:video-decoder-win": "node --import tsx scripts/build-video-decoder.ts --stage=win32-x64",
        "build:prep": "pnpm run turbo run prepare:compat-main-full",
        "build:prep:lite": "pnpm run turbo run prepare:compat-main-lite",
        "build:site": "pnpm run turbo run site:build",
        "build:site:html": "node --import tsx scripts/build-site.ts",
        "build:site:css": "tailwindcss -i ./scripts/site/site.css -o ./dist-site/styles.css --minify",
        "build:android": "pnpm run turbo run package:android-full",
        "build:android:lite": "pnpm run turbo run package:android-lite",
        "android:open": "pnpm exec cap open android",
        "build:linux": "pnpm run turbo run package:electron-linux",
        "build:linux-arm": "pnpm run turbo run package:electron-linux-arm",
        "build:mac": "pnpm run turbo run package:electron-mac",
        "build:win": "pnpm run turbo run package:electron-win",
        "build:linux:lite": "pnpm run turbo run package:electron-linux-lite",
        "build:linux-arm:lite": "pnpm run turbo run package:electron-linux-arm-lite",
        "build:mac:lite": "pnpm run turbo run package:electron-mac-lite",
        "build:win:lite": "pnpm run turbo run package:electron-win-lite",
        "bump": "ncu -u && pnpm install",
        "cleanup:logs": "node --import tsx scripts/cleanup-logs.ts",
        "cli:bankroll": "node --import tsx src/ts/shells/cli/cli.ts bankroll",
        "cli:discover": "node --import tsx src/ts/shells/cli/cli.ts discover",
        "cli:help": "node --import tsx src/ts/shells/cli/cli.ts help",
        "cli:login": "node --import tsx src/ts/shells/cli/cli.ts login",
        "cli:reset-windows": "node --import tsx src/ts/shells/cli/cli.ts reset-windows",
        "cli:start": "pnpm run prepare:video-decoder && node --import tsx src/ts/shells/cli/cli.ts start",
        "cli:status": "node --import tsx src/ts/shells/cli/cli.ts status",
        "cli:vote": "pnpm run prepare:video-decoder && node --import tsx src/ts/shells/cli/cli.ts vote",
        "dev": "pnpm run turbo run dev:electron",
        "dev:no-watch": "pnpm run turbo run dev:no-watch:electron",
        "format": "prettier --write .",
        "format:check": "pnpm run turbo run validate:format",
        "gui:refresh": "echo 'If the GUI is running, refresh it manually (Cmd+R / Ctrl+R) to apply CLI settings changes.'",
        "knip": "pnpm run turbo run validate:knip",
        "lint": "pnpm run turbo run validate:lint",
        "lint:fix": "oxlint --fix src scripts tests",
        "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('This repository requires pnpm (see packageManager in package.json); npm and yarn are not supported.');process.exit(1)}if(Number(process.versions.node.split('.')[0])<26){console.error('This repository requires Node.js 26 or newer.');process.exit(1)}\"",
        "prepare": "cross-env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 lefthook install",
        "settings:get": "node --import tsx scripts/settings-cli.ts get",
        "settings:global-defaults": "node --import tsx scripts/settings-cli.ts global-defaults",
        "settings:help": "node --import tsx scripts/settings-cli.ts help",
        "settings:reset": "node --import tsx scripts/settings-cli.ts reset",
        "settings:reset-all": "node --import tsx scripts/settings-cli.ts reset-all",
        "settings:reset-global": "node --import tsx scripts/settings-cli.ts reset-global",
        "settings:schema": "node --import tsx scripts/settings-cli.ts schema",
        "settings:set": "node --import tsx scripts/settings-cli.ts set",
        "settings:set-global": "node --import tsx scripts/settings-cli.ts set-global",
        "size": "pnpm run turbo run validate:size",
        "size:update": "cross-env NODE_ENV=production pnpm run bundle:renderer-full && node --import tsx scripts/check-size-delta.ts --update",
        "size:cli": "node --import tsx scripts/check-cli-size.ts",
        "start": "pnpm run turbo run start:electron",
        "tag": "git tag v$(node -p \"require('./package.json').version\")",
        "tag:push": "pnpm run tag && git push origin v$(node -p \"require('./package.json').version\")",
        "test": "pnpm run turbo run validate:test --",
        "test:coverage": "pnpm run turbo run validate:coverage --",
        "test:watch": "jest --watch",
        "typecheck": "pnpm run turbo run validate:typecheck",
        "turbo": "node --import tsx scripts/run-turbo.ts",
        "validate:lint": "oxlint src scripts tests",
        "validate:typecheck": "tsc --noEmit && tsc --noEmit -p tests",
        "validate:knip": "knip",
        "validate:test": "jest --runInBand",
        "validate:coverage": "jest --coverage --runInBand",
        "validate:format": "prettier --check .",
        "validate:size": "node --import tsx scripts/check-size-delta.ts",
        "validate:readme": "node --import tsx scripts/readme-version.ts --check",
        "validate:lexicon": "node --import tsx scripts/validate-lexicon.ts",
        "bundle:cli": "node --import tsx scripts/build-cli.ts --stage=bundle",
        "prepare:cli-full": "node --import tsx scripts/build-cli.ts --stage=prepare",
        "prepare:cli-lite": "node --import tsx scripts/build-cli.ts --lite --stage=prepare",
        "package:cli-mac": "node --import tsx scripts/build-cli.ts gurucli-mac --stage=package",
        "package:cli-linux": "node --import tsx scripts/build-cli.ts gurucli-linux --stage=package",
        "package:cli-linux-arm": "node --import tsx scripts/build-cli.ts gurucli-linux-arm --stage=package",
        "package:cli-all": "node --import tsx scripts/build-cli.ts --stage=package",
        "package:cli-mac-lite": "node --import tsx scripts/build-cli.ts gurucli-mac --lite --stage=package",
        "package:cli-linux-lite": "node --import tsx scripts/build-cli.ts gurucli-linux --lite --stage=package",
        "package:cli-linux-arm-lite": "node --import tsx scripts/build-cli.ts gurucli-linux-arm --lite --stage=package",
        "package:cli-all-lite": "node --import tsx scripts/build-cli.ts --lite --stage=package",
        "package:electron": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder.ts",
        "package:electron-linux": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder.ts --linux",
        "package:electron-linux-arm": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder.ts --linux --arm64",
        "package:electron-mac": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder.ts --mac",
        "package:electron-win": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder.ts --win",
        "package:electron-linux-lite": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --linux",
        "package:electron-linux-arm-lite": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --linux --arm64",
        "package:electron-mac-lite": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --mac",
        "package:electron-win-lite": "cross-env NODE_ENV=production electron-builder -c scripts/electron-builder-lite.ts --win",
        "package:android-full": "pnpm exec cap sync android && cd android && ./gradlew assembleRelease",
        "package:android-lite": "pnpm exec cap sync android && cd android && ./gradlew assembleRelease",
        "start:electron": "electron .",
        "serve:web": "node --import tsx scripts/web-server.ts",
        "dev:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/styles.css --watch",
        "dev:react": "node --import tsx scripts/build-react.ts --watch",
        "dev:main": "node --import tsx scripts/build-main.ts --watch",
        "dev:electron": "electronmon .",
        "dev:no-watch:electron": "electron .",
        "update:readme": "node --import tsx scripts/readme-version.ts",
        "verify:readme": "pnpm run turbo run validate:readme",
        "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/styles.css --watch",
        "watch:main": "node --import tsx scripts/build-main.ts --watch",
        "watch:react": "node --import tsx scripts/build-react.ts --watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/isthisgitlab/gurushots-auto-vote.git"
    },
    "keywords": [],
    "author": {
        "name": "isthisgitlab",
        "email": "isthisgitlab@isthisgitlab.com"
    },
    "license": "Apache-2.0",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/isthisgitlab/gurushots-auto-vote/issues"
    },
    "homepage": "https://github.com/isthisgitlab/gurushots-auto-vote#readme",
    "engines": {
        "node": ">=26.12.1"
    },
    "packageManager": "pnpm@12.18.0",
    "dependencies": {
        "@capacitor/android": "^8.6.0",
        "@capacitor/core": "^8.6.0",
        "@capacitor/preferences": "^8.0.1",
        "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
        "@huggingface/transformers": "^4.3.2",
        "@preact/signals": "^2.11.4",
        "axios": "^1.21.1",
        "electron-updater": "^6.8.11",
        "preact": "^11.2.0",
        "qrcode-generator": "2.0.4",
        "tar": "^7.5.22",
        "trystero": "0.26.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.6.0",
        "@electron/fuses": "^2.1.3",
        "@happy-dom/jest-environment": "^21.0.4",
        "@jest/globals": "^30.5.2",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/cli": "^4.3.5",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/preact": "^3.2.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/yauzl": "^3.4.0",
        "cross-env": "^10.1.0",
        "daisyui": "^5.7.50",
        "electron": "^45.3.0",
        "electron-builder": "^26.18.0",
        "electronmon": "^2.0.4",
        "esbuild": "^0.28.2",
        "jest": "^30.5.2",
        "jest-environment-node": "^30.5.2",
        "knip": "^6.45.0",
        "lefthook": "^2.2.2",
        "marked": "^18.2.0",
        "marked-gfm-heading-id": "^4.1.4",
        "npm-check-updates": "23.1.1",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2006",
        "postject": "1.0.0-alpha.6",
        "prettier": "4.0.0-alpha.13",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "turbo": "2.11.10",
        "typescript": "^7.0.2",
        "yaml": "2.9.1",
        "yauzl": "^3.4.0"
    },
    "electronmon": {
        "patterns": [
            "!dist/**",
            "!build/**",
            "!coverage/**",
            "!.cache/**",
            "!tests/**",
            "!docs/**",
            "!android/**",
            "!logs/**",
            "!scripts/**",
            "!**/*.test.ts",
            "!**/*.test.tsx"
        ]
    },
    "build": {
        "appId": "com.isthisgitlab.gurushotsautovote",
        "productName": "GuruShotsAutoVote",
        "afterPack": "scripts/afterPack.mts",
        "compression": "maximum",
        "removePackageScripts": true,
        "removePackageKeywords": true,
        "files": [
            "dist/**/*",
            "out/main/**/*",
            "src/html/**/*",
            "src/assets/**/*",
            "package.json",
            "!dist/vision-model${/*}",
            "!dist/ort-wasm-simd-threaded.*",
            "!**/node_modules/onnxruntime-web${/*}"
        ],
        "extraResources": [
            {
                "from": ".cache/vision-model",
                "to": "vision-model"
            },
            {
                "from": "build/video-decoder",
                "to": "video-decoder"
            }
        ],
        "asarUnpack": [
            "**/onnxruntime-node/bin/**/*",
            "**/@img/**/*"
        ],
        "directories": {
            "output": "build"
        },
        "mac": {
            "category": "public.app-category.utilities",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                },
                {
                    "target": "dir",
                    "arch": [
                        "arm64"
                    ]
                }
            ],
            "icon": "src/assets/logo.png",
            "gatekeeperAssess": false,
            "hardenedRuntime": false,
            "identity": null,
            "extendInfo": {
                "NSLocalNetworkUsageDescription": "Remote access connects your phone directly to this app over the network."
            },
            "artifactName": "GuruShotsAutoVote-v${version}-${arch}.${ext}"
        },
        "win": {
            "compression": "normal",
            "target": "portable",
            "icon": "src/assets/logo.png",
            "artifactName": "GuruShotsAutoVote-v${version}-${arch}.exe"
        },
        "linux": {
            "target": "AppImage",
            "category": "Utility",
            "icon": "src/assets/logo.png",
            "maintainer": "isthisgitlab@isthisgitlab.com",
            "artifactName": "GuruShotsAutoVote-v${version}-${arch}.AppImage"
        },
        "publish": {
            "provider": "github",
            "releaseType": "release"
        }
    },
    "jest": {
        "projects": [
            {
                "displayName": "node",
                "testEnvironment": "node",
                "roots": [
                    "<rootDir>/tests",
                    "<rootDir>/src/ts"
                ],
                "setupFilesAfterEnv": [
                    "<rootDir>/tests/setup.ts",
                    "<rootDir>/tests/setupPlatform.ts"
                ],
                "testMatch": [
                    "**/__tests__/**/*.ts",
                    "**/?(*.)+(spec|test).ts"
                ],
                "transform": {
                    "\\.[mc]?ts$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript"
                                }
                            }
                        }
                    ],
                    "\\.tsx$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript",
                                    "tsx": true
                                },
                                "transform": {
                                    "react": {
                                        "runtime": "automatic",
                                        "importSource": "preact"
                                    }
                                }
                            }
                        }
                    ]
                },
                "moduleNameMapper": {
                    "^@/(.*)$": "<rootDir>/src/ts/react/$1",
                    "^react$": "preact/compat",
                    "^react-dom$": "preact/compat",
                    "^react-dom/client$": "preact/compat/client",
                    "^react/jsx-runtime$": "preact/jsx-runtime",
                    "^react/jsx-dev-runtime$": "preact/jsx-dev-runtime"
                },
                "testPathIgnorePatterns": [
                    "<rootDir>/tests/react/"
                ]
            },
            {
                "displayName": "happy-dom",
                "testEnvironment": "@happy-dom/jest-environment",
                "transformIgnorePatterns": [
                    "/node_modules/(?!.*preact/.*\\.mjs$)"
                ],
                "testEnvironmentOptions": {
                    "customExportConditions": [
                        "node"
                    ]
                },
                "roots": [
                    "<rootDir>/tests/react",
                    "<rootDir>/src/ts"
                ],
                "setupFilesAfterEnv": [
                    "<rootDir>/tests/setup.ts",
                    "<rootDir>/tests/react/helpers/setup.ts"
                ],
                "testMatch": [
                    "**/?(*.)+(spec|test).ts",
                    "**/?(*.)+(spec|test).tsx"
                ],
                "transform": {
                    "\\.mjs$": [
                        "@swc/jest",
                        {
                            "module": {
                                "type": "commonjs"
                            }
                        }
                    ],
                    "\\.[mc]?ts$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript"
                                }
                            }
                        }
                    ],
                    "\\.tsx$": [
                        "<rootDir>/tests/helpers/swc-transformer.cts",
                        {
                            "jsc": {
                                "parser": {
                                    "syntax": "typescript",
                                    "tsx": true
                                },
                                "transform": {
                                    "react": {
                                        "runtime": "automatic",
                                        "importSource": "preact"
                                    }
                                }
                            }
                        }
                    ]
                },
                "moduleNameMapper": {
                    "^@/(.*)$": "<rootDir>/src/ts/react/$1",
                    "^react$": "preact/compat",
                    "^react-dom$": "preact/compat",
                    "^react-dom/client$": "preact/compat/client",
                    "^react/jsx-runtime$": "preact/jsx-runtime",
                    "^react/jsx-dev-runtime$": "preact/jsx-dev-runtime"
                }
            }
        ],
        "collectCoverage": false,
        "collectCoverageFrom": [
            "src/ts/**/*.{ts,tsx}",
            "scripts/**/*.{ts,mts}"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 100,
                "functions": 100,
                "lines": 100,
                "statements": 100
            }
        }
    }
}
