<?xml version="1.0" encoding="utf-8"?>
<!--
    Excludes everything the app stores from BOTH Android cloud backup and
    device-to-device transfer: the SharedPreferences (where @capacitor/preferences
    stores the GuruShots auth token), the app's files and databases (the WebView's
    local storage, the vision-model cache), and the root domain. Paired with
    android:allowBackup="false" this keeps the session token and the user's data
    from being extractable via `adb backup`, Google auto-backup, or a restore onto
    another device — matching the deliberate 0o600 file-mode hardening applied to
    the equivalent token store on Electron/CLI (src/ts/settings/storage.ts).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
