{
    // TypeScript is used here as a CHECKER ONLY — never as a compiler (noEmit).
    // checkJs is false, so `tsc` only checks files that opt in with a
    // `// @ts-check` comment at the top. This keeps the typecheck gate green
    // from day one and lets the shared core be typed incrementally via JSDoc.
    "compilerOptions": {
        "target": "es2025",
        // One program covers the core and the renderer: the renderer bundles
        // pull shared core modules into the browser, so both halves see the
        // DOM and Node typings.
        "lib": ["es2025", "dom", "dom.iterable"],
        // Bundler resolution matches how the code is loaded: esbuild bundles
        // the renderer, preload, Capacitor bridge and CLI, and swc compiles the
        // tests. require()/module.exports and import/export both type-check.
        "module": "preserve",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "jsxImportSource": "preact",
        "paths": {
            "@/*": ["./src/js/react/*"],
            "react": ["./node_modules/preact/compat"],
            "react-dom": ["./node_modules/preact/compat"],
            "react-dom/client": ["./node_modules/preact/compat/client"]
        },
        "types": ["node"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/js/**/*.js", "src/js/**/*.jsx", "lint.config.ts"],
    "exclude": ["node_modules", "dist", "build", "coverage", "android", "**/*.test.js"]
}
